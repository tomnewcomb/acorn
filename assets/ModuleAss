EQUD 0
EQUD 0
EQUD 0
EQUD 0
EQUD MDNAME
EQUD MDHELP
EQUD 0
EQUD &DFFC0 ;%000011011111111111000000
EQUD SWHANDLE
EQUD SWTABLE

.MDNAME
EQUS "PrinterPort"
EQUB 0

.MDHELP
EQUS "Printer Port"
EQUB 9
EQUS "1.00 (12 Jul 1993)"
EQUB 0

.SWTABLE
EQUS "PP"
EQUB 0
EQUS "Out"
EQUB 0
EQUS "In"
EQUB 0
EQUS "ShiftIn8"
EQUB 0
EQUS "ShiftOut32"
EQUB 0
EQUS "ShiftOut8"
EQUB 0
EQUB 0
ALIGN

.SWHANDLE
CMP R11,#5 ; NOS OF SWIS
ADDCC PC,PC,R11,LSL #2
B UKSWI
B PPOUT
B PPIN
B PPSHIFTIN8
B PPSHIFTOUT32
B PPSHIFTOUT8

.UKSWI
ADR R0,UKSWIERROR
ORRS PC,R14,#&10000000

.UKSWIERROR
EQUD &DFFC0
EQUS "Unknown printer port SWI"
EQUB 0
ALIGN

.PPOUT
STMFD R13!,{R1,R14}
LDR R1,WRITEADD
STRB R0,[R1]
EOR R0,R0,#1<<8
MOV R0,R0,LSL#12
STR R0,[R1,#&8]
LDMFD R13!,{R1,PC}^

.WRITEADD
EQUD &3350010

.PPIN
STMFD R13!,{R1,R14}
LDR R1,ADREAD
LDR R0,[R1,#&10]
AND R0,R0,#1
EOR R0,R0,#1
LDR R1,[R1]
ANDS R1,R1,#1<<6
ORRNE R0,R0,#1<<1
LDMFD R13!,{R1,PC}^

.ADREAD
EQUD &3380000

.PPSHIFTOUT8
STMFD R13!,{R0-R3,R4,R14}
LDR R1,WRITEADD
MOV R4,#8
.PPSO8L
MOV R2,#64+4+8
STRB R2,[R1]
AND R3,R0,#128
MOV R3,R3,LSR#7
ORR R2,R2,R3
STRB R2,[R1]
ORR R2,R2,#2
STRB R2,[R1]
BIC R2,R2,#2
STRB R2,[R1]
MOV R0,R0,LSL#1
SUBS R4,R4,#1
BNE PPSO8L
MOV R2,#64+4
STRB R2,[R1]
MOV R2,#64+4+8
STRB R2,[R1]
LDMFD R13!,{R0-R4,PC}^

.PPSHIFTOUT32
STMFD R13!,{R0-R4,R14}
LDR R1,WRITEADD
MOV R4,#39
.PPSO32L
MOV R2,#64+4+8
STRB R2,[R1]
AND R3,R0,#1<<31
MOV R3,R3,LSR#31
ORR R2,R2,R3
STRB R2,[R1]
ORR R2,R2,#2
STRB R2,[R1]
BIC R2,R2,#2
STRB R2,[R1]
MOV R0,R0,LSL#1
SUBS R4,R4,#1
BNE PPSO32L
MOV R2,#64+8
STRB R2,[R1]
MOV R2,#64+4+8
STRB R2,[R1]
LDMFD R13!,{R0-R4,PC}^

.PPSHIFTIN8
STMFD R13!,{R1-R5,R14}
LDR R1,WRITEADD
LDR R3,ADREAD
MOV R4,#8
MOV R2,#4+8
STRB R2,[R1]
MOV R2,#4+8+64
STRB R2,[R1]
.PPSI8L
LDRB R5,[R3]
AND R5,R5,#1<<6
MOV R0,R0,LSL#1
MOV R5,R5,LSR#6
ORR R0,R0,R5
MOV R2,#4+8+64+128
STRB R2,[R1]
MOV R2,#4+8+64
STRB R2,[R1]
SUBS R4,R4,#1
BNE PPSI8L
LDMFD R13!,{R1-R5,PC}^

ADR R0,UDSWIERROR
ORRS PC,R14,#&10000000

.UDSWIERROR
EQUD &DFFC1
EQUS "Printer port SWI not written yet"
EQUB 0
